# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# OpenAI API Settings
OPENAI_API_KEY=your-openai-api-key-here

# Twitter API Settings (twitterapi.io)
# Get your API key from: https://twitterapi.io/dashboard
# Pricing: $0.15 per 1,000 tweets (minimum $0.00015 per request)
TWITTER_API_KEY=your-twitter-api-key-here

# Database Settings (Optional - defaults to SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Media Settings
MEDIA_ROOT=/path/to/media/directory

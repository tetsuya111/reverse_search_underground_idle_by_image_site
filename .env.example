# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# OpenAI API Settings
OPENAI_API_KEY=your-openai-api-key-here

# Perplexity API Settings
# Used for search_underground_idols command to perform real-time web searches
# Get your API key from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# Twitter API Settings (twitterapi.io)
# Get your API key from: https://twitterapi.io/dashboard
# Pricing: $0.15 per 1,000 tweets (minimum $0.00015 per request)
TWITTER_API_KEY=your-twitter-api-key-here

# Instagram Settings (Instaloader)
# Optional: Login to access private accounts and avoid rate limits
# Leave empty to access public posts only
INSTAGRAM_USERNAME=your-instagram-username
INSTAGRAM_PASSWORD=your-instagram-password

# Database Settings (Optional - defaults to SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Media Settings
MEDIA_ROOT=/path/to/media/directory
